#!/usr/bin/env python3
import json
import re
import shutil
import sys
from pathlib import Path

CLAUDE = Path(__file__).resolve().parent.parent
ROOT = CLAUDE.parent
OUT = ROOT / ".opencode"
GENERATED = "Generated by .claude/bin/sync-opencode from .claude/ — edit the source, not this file."

READ_ONLY_TOOLS = {"Write", "Edit", "NotebookEdit"}


def split(path):
    text = path.read_text()
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.S)
    if not m:
        return {}, text
    meta, key = {}, None
    for line in m.group(1).splitlines():
        item = re.match(r"^\s+-\s+(.*)$", line)
        if item and key:
            meta.setdefault(key, []).append(item.group(1).strip().strip("\"'"))
            continue
        kv = re.match(r"^([A-Za-z][\w-]*):\s*(.*)$", line)
        if kv:
            key, value = kv.group(1), kv.group(2).strip()
            meta[key] = value if value else []
    return meta, m.group(2)


def yaml_str(value):
    return json.dumps(value, ensure_ascii=False)


def write(path, front, body):
    lines = ["---"] + front + ["---", ""]
    path.write_text("\n".join(lines) + body.lstrip("\n"))


def sync_agents():
    dest = OUT / "agent"
    shutil.rmtree(dest, ignore_errors=True)
    dest.mkdir(parents=True)
    names = []
    for src in sorted((CLAUDE / "agents").glob("*.md")):
        meta, body = split(src)
        front = [f"description: {yaml_str(meta.get('description', ''))}", "mode: subagent"]
        denied = {t.strip() for t in str(meta.get("disallowedTools", "")).split(",") if t.strip()}
        if denied & READ_ONLY_TOOLS:
            front += ["permission:", "  edit: deny"]
        write(dest / src.name, front, body)
        names.append(src.stem)
    return names


def sync_commands():
    dest = OUT / "command"
    shutil.rmtree(dest, ignore_errors=True)
    dest.mkdir(parents=True)
    names = []
    for src in sorted((CLAUDE / "commands").glob("*.md")):
        meta, body = split(src)
        front = [f"description: {yaml_str(meta.get('description', ''))}"]
        write(dest / src.name, front, body)
        names.append(src.stem)
    return names


def rule_index():
    rows = []
    for src in sorted((CLAUDE / "rules").glob("*.md")):
        meta, _ = split(src)
        paths = meta.get("paths") or []
        globs = ", ".join(f"`{p}`" for p in paths) if paths else "any file"
        rows.append(f"| {globs} | `.claude/rules/{src.name}` |")
    return rows


def write_agents_md(agents, commands):
    lines = [
        "# AGENTS.md",
        "",
        f"<!-- {GENERATED} -->",
        "",
        "Workspace instructions live in `.claude/CLAUDE.md` and are loaded through `opencode.json`. Follow them.",
        "",
        "## Path-scoped rules",
        "",
        "Before reading or editing a file matching a pattern below, read the rule file for it. Patterns are relative to this directory.",
        "",
        "| Paths | Rule file |",
        "|-------|-----------|",
        *rule_index(),
        "",
        "## Name mapping",
        "",
        "Where the instructions say `/<agent>` (e.g. `/go-coder`), use the opencode subagent of that name: "
        + ", ".join(f"`@{a}`" for a in agents) + ".",
        "",
        "Workflow commands: " + ", ".join(f"`/{c}`" for c in commands) + ".",
        "",
        "Skills are in `.claude/skills/` and load through the skill tool.",
        "",
    ]
    (ROOT / "AGENTS.md").write_text("\n".join(lines))


def write_config():
    path = ROOT / "opencode.json"
    config = json.loads(path.read_text()) if path.exists() else {}
    config.setdefault("$schema", "https://opencode.ai/config.json")
    instructions = config.setdefault("instructions", [])
    if ".claude/CLAUDE.md" not in instructions:
        instructions.append(".claude/CLAUDE.md")
    skill_paths = config.setdefault("skills", {}).setdefault("paths", [])
    if ".claude/skills" not in skill_paths:
        skill_paths.append(".claude/skills")
    path.write_text(json.dumps(config, indent=2) + "\n")


def main():
    agents = sync_agents()
    commands = sync_commands()
    write_agents_md(agents, commands)
    write_config()
    print(f"opencode: {len(agents)} agents, {len(commands)} commands, rules index, config -> {ROOT}", file=sys.stderr)


if __name__ == "__main__":
    main()
